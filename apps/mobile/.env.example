# Copie para `.env` (gitignored) neste diretório. Variáveis `EXPO_PUBLIC_*` são
# inlined pelo Metro em build time — nunca segredo aqui, só client IDs públicos
# (audience do id_token, igual ao backend). Placeholders vazios até o dono
# provisionar os projetos reais (docs/fases-construcao.md > Depende de você).

# Local: http://localhost:8010/api (porta fixa da Onda 1, docs/fases-construcao.md).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8010/api

# iOS e Android ainda não existem (Android precisa do SHA-1 do build EAS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web já provisionado (2026-09-26) — não é segredo, mas o valor real só entra
# no `.env` local (nunca versionado); aqui fica vazio de propósito.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
