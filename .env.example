# Copie para `.env` (gitignored) e preencha. `.env` dirige DOIS eixos:
#   ENVIRONMENT  → qual config/app/{env}.yaml o backend lê.
#   COMPOSE_FILE → quais overrides o `docker compose` mescla (sem precisar de `-f`).

ENVIRONMENT=local
COMPOSE_FILE=compose.yaml:config/docker/compose.local.yaml
# Em prod: ENVIRONMENT=prod / COMPOSE_FILE=compose.yaml:config/docker/compose.prod.yaml

# UID do host para a imagem do backend (evita arquivo criado pelo container com dono
# errado em binds tipo ./backend/uploads). Só mude se seu usuário local não é 1000.
APP_UID=1000

# --- Segredos (nunca commitar valor real) ---
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
JWT_SECRET_KEY=
# Único provider de IA (OpenRouter — API OpenAI-compatible; modelos Gemini também
# ficam disponíveis por lá, ver `config/app/*.yaml > ai.tasks`).
OPENROUTER_API_KEY=

# Google OAuth — cliente "Aplicativo da Web" (Google Cloud > Auth Platform > Clientes).
# O client ID não é segredo e também fica em config/app/{env}.yaml > auth.google.client_id_web;
# o secret só é usado pelo login da web (troca do code).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
