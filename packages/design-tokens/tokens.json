{
  "$description": "EconoMerc — fonte única da identidade visual. Editar aqui e rodar `bun run build`. Nunca editar dist/ à mão.",
  "version": "0.1.0",

  "palette": {
    "verde": {
      "50": "#EAF6EF", "100": "#CDEBDA", "200": "#9FD6B8", "300": "#66BB90", "400": "#3DBB82",
      "500": "#148356", "600": "#0E6B47", "700": "#0B573A", "800": "#09442E", "900": "#0A2E1F", "950": "#041C13"
    },
    "etiqueta": {
      "50": "#FFF8E1", "100": "#FFF3CC", "200": "#FFE07A", "300": "#FFD34F", "400": "#FFC83D",
      "500": "#F2AE12", "600": "#CC8A00", "700": "#9E6800", "800": "#8A5A00", "900": "#4D3200"
    },
    "grafite": {
      "0": "#FFFFFF", "25": "#FBFAF6", "50": "#F7F6F1", "100": "#EEEDE6", "200": "#DEDDD4", "300": "#C4C3B8",
      "400": "#9A9A8E", "500": "#72746A", "600": "#5B6159", "700": "#3D413A", "800": "#1F2A22", "850": "#172019",
      "900": "#10231A", "950": "#0F1511"
    },
    "coral": { "50": "#FDECEA", "400": "#F07A6E", "600": "#C7372F", "900": "#3A1A17" },
    "azul": { "400": "#7FA6F0", "600": "#2F6FDB" }
  },

  "themes": {
    "light": {
      "background": "{grafite.50}",
      "surface": "{grafite.0}",
      "surface-muted": "{grafite.100}",
      "border": "{grafite.200}",
      "foreground": "{grafite.900}",
      "foreground-muted": "{grafite.600}",
      "primary": "{verde.600}",
      "primary-foreground": "{grafite.0}",
      "primary-soft": "{verde.50}",
      "accent": "{etiqueta.400}",
      "accent-foreground": "{grafite.900}",
      "accent-soft": "{etiqueta.100}",
      "danger": "{coral.600}",
      "danger-foreground": "{grafite.0}",
      "danger-soft": "{coral.50}",
      "warning": "{etiqueta.800}",
      "warning-soft": "{etiqueta.100}",
      "info": "{azul.600}",
      "savings": "{verde.600}",
      "ring": "{verde.600}",
      "scrim": "rgba(4, 28, 19, 0.5)"
    },
    "dark": {
      "background": "{grafite.950}",
      "surface": "{grafite.850}",
      "surface-muted": "{grafite.800}",
      "border": "#2C382F",
      "foreground": "#E9EEE9",
      "foreground-muted": "#9AA59C",
      "primary": "{verde.400}",
      "primary-foreground": "{verde.900}",
      "primary-soft": "#13301F",
      "accent": "{etiqueta.400}",
      "accent-foreground": "{grafite.900}",
      "accent-soft": "#3A2F0E",
      "danger": "{coral.400}",
      "danger-foreground": "{grafite.950}",
      "danger-soft": "{coral.900}",
      "warning": "{etiqueta.400}",
      "warning-soft": "#3A2F0E",
      "info": "{azul.400}",
      "savings": "{verde.400}",
      "ring": "{verde.400}",
      "scrim": "rgba(0, 0, 0, 0.6)"
    }
  },

  "charts": {
    "$note": "Validado com dataviz/validate_palette.js (CVD, visão normal, contraste). Máx. 6 séries; o resto vira 'Outros'. Cor segue a entidade, nunca o ranking.",
    "categorical": {
      "light": ["#1E8A5A", "#2F6FDB", "#E29A00", "#6A4FC2", "#E0604F", "#169BA8"],
      "dark": ["#249660", "#4C7FE0", "#B87D0A", "#8C73E6", "#DB604F", "#1E9CA8"]
    },
    "other": { "light": "#9A9A8E", "dark": "#72746A" },
    "sequential": "verde"
  },

  "font": {
    "family": {
      "display": "Bricolage Grotesque",
      "sans": "Inter"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "scale": {
      "$note": "Mobile-first, em pt/px. `price-*` sempre com algarismos tabulares (tabular-nums).",
      "price-hero": { "size": 44, "line": 48, "family": "display", "weight": 800, "tracking": -1 },
      "display": { "size": 34, "line": 40, "family": "display", "weight": 800, "tracking": -0.5 },
      "title-1": { "size": 28, "line": 34, "family": "display", "weight": 700, "tracking": -0.3 },
      "title-2": { "size": 22, "line": 28, "family": "display", "weight": 700, "tracking": 0 },
      "title-3": { "size": 18, "line": 24, "family": "sans", "weight": 600, "tracking": 0 },
      "body": { "size": 16, "line": 24, "family": "sans", "weight": 400, "tracking": 0 },
      "callout": { "size": 15, "line": 22, "family": "sans", "weight": 500, "tracking": 0 },
      "footnote": { "size": 13, "line": 18, "family": "sans", "weight": 400, "tracking": 0 },
      "caption": { "size": 12, "line": 16, "family": "sans", "weight": 500, "tracking": 0.2 },
      "price": { "size": 17, "line": 22, "family": "sans", "weight": 600, "tracking": 0 }
    }
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "size": { "touch-min": 44, "icon-sm": 16, "icon-md": 24, "icon-lg": 32, "scan-button": 72 },

  "elevation": {
    "1": "0 1px 2px rgba(16, 35, 26, 0.06), 0 1px 1px rgba(16, 35, 26, 0.04)",
    "2": "0 4px 12px rgba(16, 35, 26, 0.08), 0 2px 4px rgba(16, 35, 26, 0.04)",
    "3": "0 12px 32px rgba(16, 35, 26, 0.14), 0 4px 8px rgba(16, 35, 26, 0.06)"
  },

  "motion": {
    "duration": { "fast": 150, "base": 220, "slow": 320 },
    "easing": {
      "enter": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "spring": { "damping": 18, "stiffness": 220, "mass": 1 }
  }
}
